{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/AGENTS.md"],
  "lsp": true,
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "-y",
        "@playwright/mcp@latest",
        "--browser=firefox"
      ],
      "enabled": true
    }
  }
}
