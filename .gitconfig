# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
	name = Dhananjay
	email = itsmrnatural@duck.com
	signingkey = 3D280550B702CBB9
[commit]
	gpgsign = true
[gpg]
	program = gpg
[tag]
	gpgSign = true
[core]
	pager = delta
	editor = hx
	hooksPath = /Users/natural/.dotfiles/.config/git/hooks
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
[merge]
	conflictStyle = zdiff3
